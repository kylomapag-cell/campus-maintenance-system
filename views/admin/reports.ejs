<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Campus Facility Maintenance Reports</h1>
    <p class="text-muted small mb-0">Operational efficiency, breakdown analytics, and resolution metrics.</p>
  </div>
  <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-semibold">
    <i class="bi bi-printer me-1"></i> Print / Export Report
  </button>
</div>

<!-- Key Performance Indicators Row -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card shadow-sm border-0 h-100 p-3">
      <small class="text-muted fw-bold">TOTAL CAMPUS INCIDENTS</small>
      <div class="fs-2 fw-bold text-dark mt-1"><%= stats.total %></div>
      <small class="text-muted">Since system inception</small>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 h-100 p-3">
      <small class="text-muted fw-bold">COMPLETION RATE</small>
      <div class="fs-2 fw-bold text-success mt-1">
        <%= stats.total > 0 ? Math.round((stats.completed / stats.total) * 100) : 0 %>%
      </div>
      <small class="text-muted"><%= stats.completed %> of <%= stats.total %> tickets resolved</small>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 h-100 p-3">
      <small class="text-muted fw-bold">AVG RESOLUTION TIME</small>
      <div class="fs-2 fw-bold text-primary mt-1">
        <%= avgHours %> <span class="fs-5 fw-normal text-muted">hrs</span>
      </div>
      <small class="text-muted">Turnaround from submission to fix</small>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 h-100 p-3">
      <small class="text-muted fw-bold">ACCESSIBILITY BARRIERS (IR2)</small>
      <div class="fs-2 fw-bold text-warning-emphasis mt-1"><%= stats.accessibility %></div>
      <small class="text-muted">High-priority physical barriers</small>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <!-- Building Frequency Table -->
  <div class="col-lg-6">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-buildings text-primary me-2"></i>Incident Frequency by Campus Building</h5>
      </div>
      <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="ps-3">Building Name</th>
              <th scope="col">Incident Count</th>
              <th scope="col" class="text-end pe-3">% Share</th>
            </tr>
          </thead>
          <tbody>
            <% if (stats.byBuilding && stats.byBuilding.length > 0) { %>
              <% stats.byBuilding.forEach(b => { %>
                <tr>
                  <td class="ps-3 fw-semibold text-dark"><%= b.building %></td>
                  <td>
                    <span class="badge bg-light text-dark border"><%= b.count %> requests</span>
                  </td>
                  <td class="text-end pe-3">
                    <span class="fw-bold text-secondary">
                      <%= stats.total > 0 ? Math.round((b.count / stats.total) * 100) : 0 %>%
                    </span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="3" class="text-center py-3 text-muted">No data available</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Category Breakdown Table -->
  <div class="col-lg-6">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-tools text-primary me-2"></i>Issue Distribution by Category</h5>
      </div>
      <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="ps-3">Category</th>
              <th scope="col">Tickets</th>
              <th scope="col" class="text-end pe-3">Ratio</th>
            </tr>
          </thead>
          <tbody>
            <% if (stats.byCategory && stats.byCategory.length > 0) { %>
              <% stats.byCategory.forEach(c => { %>
                <tr>
                  <td class="ps-3 fw-semibold">
                    <%= c.category %>
                    <% if (c.category === 'Accessibility Barrier') { %>
                      <span class="badge bg-warning-subtle text-warning-emphasis border ms-1">IR2 Mandate</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border"><%= c.count %> requests</span>
                  </td>
                  <td class="text-end pe-3">
                    <div class="progress d-inline-flex" style="width: 80px; height: 8px;">
                      <div class="progress-bar bg-primary" style="width: <%= Math.round((c.count / stats.total) * 100) %>%;"></div>
                    </div>
                    <span class="small text-muted ms-2"><%= Math.round((c.count / stats.total) * 100) %>%</span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="3" class="text-center py-3 text-muted">No data available</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Technician Workload Table -->
<div class="card shadow-sm border-0 mb-4">
  <div class="card-header bg-white py-3 border-bottom">
    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-wrench text-primary me-2"></i>Technician Workload &amp; Specialization Distribution</h5>
  </div>
  <div class="card-body p-0">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col" class="ps-4">Technician Name</th>
          <th scope="col">Staff ID Badge</th>
          <th scope="col">Specialty Area</th>
          <th scope="col">Department</th>
          <th scope="col" class="text-end pe-4">System Contact</th>
        </tr>
      </thead>
      <tbody>
        <% technicians.forEach(t => { %>
          <tr>
            <td class="ps-4 fw-bold text-dark"><%= t.name %></td>
            <td><span class="badge bg-primary font-monospace"><%= t.staff_id %></span></td>
            <td><span class="small"><%= t.specialization || 'Physical Plant Staff' %></span></td>
            <td><span class="small text-muted"><%= t.department %></span></td>
            <td class="text-end pe-4 small text-muted"><%= t.email %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
