<%- include('partials/header') %>

<div class="row justify-content-center text-center my-5 py-4">
  <div class="col-md-7 col-lg-5">
    <div class="display-1 fw-bold text-danger mb-3">500</div>
    <h2 class="h3 fw-bold mb-3">Internal Server Error</h2>
    <p class="text-muted mb-4">
      An unexpected error occurred while processing your request. Please try again later.
    </p>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-light text-start border p-3 mb-4 font-monospace small">
        <%= error %>
      </div>
    <% } %>
    <a href="/" class="btn btn-primary px-4 py-2">
      <i class="bi bi-arrow-left me-2"></i>Return Home
    </a>
  </div>
</div>

<%- include('partials/footer') %>
