<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <h1 class="h3 fw-bold mb-0">Technician Workspace</h1>
      <span class="badge bg-primary font-monospace px-3 py-1">
        <i class="bi bi-person-badge me-1"></i><%= user.staff_id || 'CSPC-STAFF' %>
      </span>
    </div>
    <p class="text-muted small mb-0">Physical Plant Operations &bull; Maintenance Technician: <strong><%= user.name %></strong></p>
  </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-card-icon bg-primary bg-opacity-10 text-primary">
          <i class="bi bi-card-checklist fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold lh-1"><%= stats.totalAssigned %></div>
          <small class="text-muted fw-semibold">My Assigned Tasks</small>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-card-icon bg-info bg-opacity-10 text-info">
          <i class="bi bi-wrench-adjustable-circle fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold lh-1"><%= stats.inProgress %></div>
          <small class="text-muted fw-semibold">Active In Progress</small>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-card-icon bg-success bg-opacity-10 text-success">
          <i class="bi bi-check-all fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold lh-1"><%= stats.completed %></div>
          <small class="text-muted fw-semibold">Tasks Completed</small>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-card-icon bg-warning bg-opacity-10 text-warning">
          <i class="bi bi-inbox fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold lh-1"><%= stats.unassignedPool %></div>
          <small class="text-muted fw-semibold">Unclaimed Pool</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Tabs for Assigned vs Unassigned Queue -->
<ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active fw-semibold" id="pills-assigned-tab" data-bs-toggle="pill" data-bs-target="#pills-assigned" type="button" role="tab">
      <i class="bi bi-person-check me-1"></i> My Assigned Tasks (<%= assignedTickets.length %>)
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link fw-semibold" id="pills-pool-tab" data-bs-toggle="pill" data-bs-target="#pills-pool" type="button" role="tab">
      <i class="bi bi-collection me-1"></i> Unassigned Campus Tickets (<%= unassignedTickets.length %>)
    </button>
  </li>
</ul>

<div class="tab-content" id="pills-tabContent">
  <!-- Tab 1: Assigned Tickets -->
  <div class="tab-pane fade show active" id="pills-assigned" role="tabpanel">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Assigned Work Orders</h5>
        <form action="/staff/dashboard" method="GET" class="d-flex gap-2">
          <select class="form-select form-select-sm" name="status" onchange="this.form.submit()">
            <option value="all" <%= typeof status === 'undefined' || status === 'all' ? 'selected' : '' %>>All Statuses</option>
            <option value="In Progress" <%= typeof status !== 'undefined' && status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
            <option value="Pending" <%= typeof status !== 'undefined' && status === 'Pending' ? 'selected' : '' %>>Pending</option>
            <option value="Completed" <%= typeof status !== 'undefined' && status === 'Completed' ? 'selected' : '' %>>Completed</option>
          </select>
        </form>
      </div>
      <div class="card-body p-0">
        <% if (assignedTickets && assignedTickets.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="ps-4">Ticket</th>
                  <th scope="col">Subject &amp; Room</th>
                  <th scope="col">Requester</th>
                  <th scope="col">Category</th>
                  <th scope="col">Priority</th>
                  <th scope="col">Status</th>
                  <th scope="col" class="text-end pe-4">Work Action</th>
                </tr>
              </thead>
              <tbody>
                <% assignedTickets.forEach(ticket => { %>
                  <tr>
                    <td class="ps-4 fw-bold">
                      <a href="/requests/<%= ticket.id %>" class="text-decoration-none">
                        #<%= ticket.ticket_number %>
                      </a>
                    </td>
                    <td>
                      <div class="fw-semibold text-dark"><%= ticket.title %></div>
                      <small class="text-muted"><i class="bi bi-geo-alt me-1"></i><%= ticket.building %> &bull; <%= ticket.floor %> &bull; <%= ticket.room %></small>
                      <% if (ticket.is_private_area) { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size: 0.68rem;">
                          <i class="bi bi-shield-lock me-1"></i>Private Area (ID Required)
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <div class="small fw-semibold"><%= ticket.requester_name %></div>
                      <small class="text-muted"><%= ticket.requester_dept || 'CSPC' %></small>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border"><%= ticket.category %></span>
                    </td>
                    <td>
                      <% if (ticket.priority === 'Urgent') { %>
                        <span class="badge badge-priority-urgent">Urgent</span>
                      <% } else if (ticket.priority === 'High') { %>
                        <span class="badge badge-priority-high">High</span>
                      <% } else if (ticket.priority === 'Normal') { %>
                        <span class="badge badge-priority-normal">Normal</span>
                      <% } else { %>
                        <span class="badge badge-priority-low">Low</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (ticket.status === 'Pending') { %>
                        <span class="badge badge-status-pending"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                      <% } else if (ticket.status === 'In Progress') { %>
                        <span class="badge badge-status-in-progress"><i class="bi bi-wrench me-1"></i>In Progress</span>
                      <% } else if (ticket.status === 'Completed') { %>
                        <span class="badge badge-status-completed"><i class="bi bi-check-circle me-1"></i>Completed</span>
                      <% } else { %>
                        <span class="badge badge-status-cancelled">Cancelled</span>
                      <% } %>
                    </td>
                    <td class="text-end pe-4">
                      <a href="/requests/<%= ticket.id %>" class="btn btn-sm btn-primary">
                        <i class="bi bi-pencil-square me-1"></i> Update Status
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5">
            <i class="bi bi-clipboard-check fs-1 text-muted d-block mb-2"></i>
            <h6 class="fw-bold">No Assigned Tasks Found</h6>
            <p class="text-muted small mb-0">Check the unassigned campus tickets tab to claim available work orders.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Tab 2: Unassigned Tickets Queue -->
  <div class="tab-pane fade" id="pills-pool" role="tabpanel">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0 text-dark">Open Tickets Ready for Claiming</h5>
      </div>
      <div class="card-body p-0">
        <% if (unassignedTickets && unassignedTickets.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="ps-4">Ticket</th>
                  <th scope="col">Problem &amp; Location</th>
                  <th scope="col">Category</th>
                  <th scope="col">Priority</th>
                  <th scope="col">Submitted</th>
                  <th scope="col" class="text-end pe-4">Action</th>
                </tr>
              </thead>
              <tbody>
                <% unassignedTickets.forEach(t => { %>
                  <tr>
                    <td class="ps-4 fw-bold">
                      <a href="/requests/<%= t.id %>" class="text-decoration-none">
                        #<%= t.ticket_number %>
                      </a>
                    </td>
                    <td>
                      <div class="fw-semibold text-dark"><%= t.title %></div>
                      <small class="text-muted"><%= t.building %> &bull; <%= t.room %></small>
                      <% if (t.is_private_area) { %>
                        <span class="badge bg-success-subtle text-success border ms-1" style="font-size: 0.68rem;">Private Area</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border"><%= t.category %></span>
                    </td>
                    <td>
                      <% if (t.priority === 'Urgent') { %>
                        <span class="badge badge-priority-urgent">Urgent</span>
                      <% } else if (t.priority === 'High') { %>
                        <span class="badge badge-priority-high">High</span>
                      <% } else { %>
                        <span class="badge badge-priority-normal"><%= t.priority %></span>
                      <% } %>
                    </td>
                    <td class="text-muted small">
                      <%= new Date(t.created_at).toLocaleDateString() %>
                    </td>
                    <td class="text-end pe-4">
                      <form action="/staff/requests/<%= t.id %>/claim" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold">
                          <i class="bi bi-hand-index me-1"></i> Claim Ticket
                        </button>
                      </form>
                      <a href="/requests/<%= t.id %>" class="btn btn-sm btn-outline-secondary ms-1">View</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5">
            <i class="bi bi-check2-all fs-1 text-success d-block mb-2"></i>
            <h6 class="fw-bold">No Unassigned Tickets Available</h6>
            <p class="text-muted small mb-0">All current campus maintenance requests have been claimed or assigned.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
