<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Campus Maintenance System' %></title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
  <!-- Skip to Content for Digital Accessibility (WCAG 2.1 AA / IR1) -->
  <a href="#main-content" class="skip-link visually-hidden-focusable p-2 bg-primary text-white">Skip to main content</a>

  <header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-2">
      <div class="container-fluid px-lg-4">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
          <div class="brand-icon d-flex align-items-center justify-content-center bg-primary rounded-3 text-white">
            <i class="bi bi-tools fs-5"></i>
          </div>
          <div>
            <div class="fw-bold tracking-tight lh-1">CSPC Maintenance</div>
            <small class="text-secondary d-none d-sm-inline" style="font-size: 0.72rem;">Campus Facilities Management</small>
          </div>
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
            <% if (currentUser) { %>
              <% if (currentUser.role === 'admin') { %>
                <li class="nav-item">
                  <a class="nav-link <%= currentPath === '/admin/dashboard' ? 'active fw-semibold' : '' %>" href="/admin/dashboard">
                    <i class="bi bi-speedometer2 me-1"></i> Command Center
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link <%= currentPath === '/admin/requests' ? 'active fw-semibold' : '' %>" href="/admin/requests">
                    <i class="bi bi-list-task me-1"></i> All Campus Tickets
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link <%= currentPath === '/admin/users' ? 'active fw-semibold' : '' %>" href="/admin/users">
                    <i class="bi bi-people me-1"></i> User Roles
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link <%= currentPath === '/admin/reports' ? 'active fw-semibold' : '' %>" href="/admin/reports">
                    <i class="bi bi-bar-chart-line me-1"></i> Analytics &amp; Reports
                  </a>
                </li>
              <% } else if (currentUser.role === 'staff') { %>
                <li class="nav-item">
                  <a class="nav-link <%= currentPath === '/staff/dashboard' ? 'active fw-semibold' : '' %>" href="/staff/dashboard">
                    <i class="bi bi-wrench me-1"></i> Technician Workspace
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link <%= currentPath === '/requests/new' ? 'active fw-semibold' : '' %>" href="/requests/new">
                    <i class="bi bi-plus-circle me-1"></i> Report Issue
                  </a>
                </li>
              <% } else { %>
                <li class="nav-item">
                  <a class="nav-link <%= currentPath === '/dashboard' ? 'active fw-semibold' : '' %>" href="/dashboard">
                    <i class="bi bi-columns-gap me-1"></i> My Dashboard
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link <%= currentPath === '/requests' ? 'active fw-semibold' : '' %>" href="/requests">
                    <i class="bi bi-ticket-detailed me-1"></i> My Requests
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link text-warning fw-semibold <%= currentPath === '/requests/new' ? 'active' : '' %>" href="/requests/new">
                    <i class="bi bi-plus-circle-fill me-1"></i> Submit Request
                  </a>
                </li>
              <% } %>
            <% } %>
          </ul>

          <div class="d-flex align-items-center gap-2">
            <% if (currentUser) { %>
              <div class="dropdown">
                <button class="btn btn-outline-light btn-sm dropdown-toggle d-flex align-items-center gap-2 py-1 px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="bi bi-person-circle fs-5"></i>
                  <span class="d-none d-md-inline"><%= currentUser.name %></span>
                  <span class="badge rounded-pill <%= currentUser.role === 'admin' ? 'bg-danger' : currentUser.role === 'staff' ? 'bg-primary' : currentUser.role === 'faculty' ? 'bg-info text-dark' : 'bg-secondary' %> text-uppercase" style="font-size: 0.65rem;">
                    <%= currentUser.role %>
                  </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                  <li class="px-3 py-2 border-bottom">
                    <div class="fw-bold"><%= currentUser.name %></div>
                    <small class="text-muted"><%= currentUser.email %></small>
                    <% if (currentUser.staff_id) { %>
                      <div class="text-primary mt-1" style="font-size: 0.75rem;">
                        <i class="bi bi-person-badge me-1"></i>ID: <%= currentUser.staff_id %>
                      </div>
                    <% } %>
                  </li>
                  <li><a class="dropdown-item py-2" href="/profile"><i class="bi bi-gear me-2"></i> Account Profile</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <form action="/logout" method="POST" class="m-0">
                      <button type="submit" class="dropdown-item py-2 text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                      </button>
                    </form>
                  </li>
                </ul>
              </div>
            <% } else { %>
              <a href="/login" class="btn btn-outline-light btn-sm px-3">Sign In</a>
              <a href="/register" class="btn btn-primary btn-sm px-3">Register</a>
            <% } %>
          </div>
        </div>
      </div>
    </nav>
  </header>

  <!-- Flash Alerts Partial -->
  <div class="container-fluid px-lg-4 mt-3">
    <%- include('alerts') %>
  </div>

  <main id="main-content" class="flex-grow-1 container-fluid px-lg-4 py-3">
