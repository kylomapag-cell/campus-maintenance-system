<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Campus Maintenance Tickets</h1>
    <p class="text-muted small mb-0">Total <%= requests.length %> tickets recorded in the campus maintenance system.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/requests/new" class="btn btn-primary btn-sm fw-semibold">
      <i class="bi bi-plus-circle me-1"></i> New Request
    </a>
  </div>
</div>

<!-- Multi-Filter Toolbar -->
<div class="card shadow-sm border-0 mb-4">
  <div class="card-body p-3">
    <form action="/admin/requests" method="GET" class="row g-2 align-items-center">
      <div class="col-md-3">
        <input 
          type="text" 
          class="form-control form-control-sm" 
          name="search" 
          placeholder="Search ticket #, title, room..." 
          value="<%= filters.search %>"
        >
      </div>

      <div class="col-sm-6 col-md-2">
        <select class="form-select form-select-sm" name="status">
          <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
          <option value="Pending" <%= filters.status === 'Pending' ? 'selected' : '' %>>Pending</option>
          <option value="In Progress" <%= filters.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
          <option value="Completed" <%= filters.status === 'Completed' ? 'selected' : '' %>>Completed</option>
          <option value="Cancelled" <%= filters.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
      </div>

      <div class="col-sm-6 col-md-2">
        <select class="form-select form-select-sm" name="category">
          <option value="all" <%= filters.category === 'all' ? 'selected' : '' %>>All Categories</option>
          <% categories.forEach(c => { %>
            <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-sm-6 col-md-2">
        <select class="form-select form-select-sm" name="priority">
          <option value="all" <%= filters.priority === 'all' ? 'selected' : '' %>>All Priorities</option>
          <option value="Urgent" <%= filters.priority === 'Urgent' ? 'selected' : '' %>>Urgent</option>
          <option value="High" <%= filters.priority === 'High' ? 'selected' : '' %>>High</option>
          <option value="Normal" <%= filters.priority === 'Normal' ? 'selected' : '' %>>Normal</option>
          <option value="Low" <%= filters.priority === 'Low' ? 'selected' : '' %>>Low</option>
        </select>
      </div>

      <div class="col-sm-6 col-md-2">
        <select class="form-select form-select-sm" name="building">
          <option value="all" <%= filters.building === 'all' ? 'selected' : '' %>>All Buildings</option>
          <% buildings.forEach(b => { %>
            <option value="<%= b %>" <%= filters.building === b ? 'selected' : '' %>><%= b %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-1 d-flex gap-1">
        <button type="submit" class="btn btn-sm btn-primary w-100" title="Apply Filter">
          <i class="bi bi-filter"></i>
        </button>
        <a href="/admin/requests" class="btn btn-sm btn-outline-secondary" title="Reset Filters">
          <i class="bi bi-arrow-counterclockwise"></i>
        </a>
      </div>
    </form>
  </div>
</div>

<!-- Table Card -->
<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <% if (requests && requests.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="ps-3">Ticket</th>
              <th scope="col">Subject &amp; Location</th>
              <th scope="col">Requester</th>
              <th scope="col">Category</th>
              <th scope="col">Priority</th>
              <th scope="col">Status</th>
              <th scope="col">Assigned Technician (Dispatch)</th>
              <th scope="col" class="text-end pe-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% requests.forEach(r => { %>
              <tr>
                <td class="ps-3 fw-bold">
                  <a href="/requests/<%= r.id %>" class="text-decoration-none">
                    #<%= r.ticket_number %>
                  </a>
                </td>
                <td>
                  <div class="fw-semibold text-dark text-truncate" style="max-width: 260px;"><%= r.title %></div>
                  <small class="text-muted"><%= r.building %> &bull; <%= r.floor %> &bull; <%= r.room %></small>
                  <% if (r.is_private_area) { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size: 0.65rem;">
                      <i class="bi bi-shield-check me-1"></i>Private Area
                    </span>
                  <% } %>
                </td>
                <td>
                  <div class="small fw-semibold"><%= r.requester_name %></div>
                  <small class="text-muted"><%= r.requester_email %></small>
                </td>
                <td>
                  <span class="badge bg-light text-dark border"><%= r.category %></span>
                </td>
                <td>
                  <% if (r.priority === 'Urgent') { %>
                    <span class="badge badge-priority-urgent">Urgent</span>
                  <% } else if (r.priority === 'High') { %>
                    <span class="badge badge-priority-high">High</span>
                  <% } else if (r.priority === 'Normal') { %>
                    <span class="badge badge-priority-normal">Normal</span>
                  <% } else { %>
                    <span class="badge badge-priority-low">Low</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.status === 'Pending') { %>
                    <span class="badge badge-status-pending">Pending</span>
                  <% } else if (r.status === 'In Progress') { %>
                    <span class="badge badge-status-in-progress">In Progress</span>
                  <% } else if (r.status === 'Completed') { %>
                    <span class="badge badge-status-completed">Completed</span>
                  <% } else { %>
                    <span class="badge badge-status-cancelled">Cancelled</span>
                  <% } %>
                </td>
                <td>
                  <form action="/admin/requests/<%= r.id %>/assign" method="POST" class="d-inline-flex gap-1 align-items-center">
                    <select name="technician_id" class="form-select form-select-sm" style="width: 150px;" required>
                      <option value="">Choose tech...</option>
                      <% technicians.forEach(t => { %>
                        <option value="<%= t.id %>" <%= r.assigned_to === t.id ? 'selected' : '' %>>
                          <%= t.name %> (<%= t.staff_id %>)
                        </option>
                      <% }) %>
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Assign Technician">
                      <i class="bi bi-check2"></i>
                    </button>
                  </form>
                </td>
                <td class="text-end pe-3">
                  <div class="d-inline-flex gap-1">
                    <a href="/requests/<%= r.id %>" class="btn btn-sm btn-outline-secondary" title="View Details">
                      <i class="bi bi-eye"></i>
                    </a>
                    <form action="/admin/requests/<%= r.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete ticket #<%= r.ticket_number %>? This action cannot be undone.');">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Ticket">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
        <h6 class="fw-bold">No Maintenance Requests Found</h6>
        <p class="text-muted small mb-0">No records matched your active query filters.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
