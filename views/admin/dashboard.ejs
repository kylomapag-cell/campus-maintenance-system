<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Facility Operations Command Center</h1>
    <p class="text-muted small mb-0">Campus Facilities Management &bull; Administrator: <strong><%= user.name %></strong></p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/requests" class="btn btn-outline-primary btn-sm fw-semibold">
      <i class="bi bi-list-check me-1"></i> Manage All Tickets
    </a>
    <a href="/admin/reports" class="btn btn-primary btn-sm fw-semibold">
      <i class="bi bi-file-earmark-bar-graph me-1"></i> Facility Reports
    </a>
  </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-4 col-xl-2">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <small class="text-muted fw-bold">TOTAL TICKETS</small>
          <i class="bi bi-archive text-primary fs-5"></i>
        </div>
        <div class="fs-3 fw-bold text-dark"><%= stats.total %></div>
        <small class="text-muted" style="font-size: 0.72rem;">All campus submissions</small>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 col-xl-2">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <small class="text-muted fw-bold">PENDING</small>
          <i class="bi bi-hourglass-split text-warning fs-5"></i>
        </div>
        <div class="fs-3 fw-bold text-warning-emphasis"><%= stats.pending %></div>
        <small class="text-muted" style="font-size: 0.72rem;">Needs dispatch/review</small>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 col-xl-2">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <small class="text-muted fw-bold">IN PROGRESS</small>
          <i class="bi bi-wrench-adjustable text-info fs-5"></i>
        </div>
        <div class="fs-3 fw-bold text-primary"><%= stats.inProgress %></div>
        <small class="text-muted" style="font-size: 0.72rem;">Under technician repair</small>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 col-xl-2">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <small class="text-muted fw-bold">RESOLVED</small>
          <i class="bi bi-check2-circle text-success fs-5"></i>
        </div>
        <div class="fs-3 fw-bold text-success"><%= stats.completed %></div>
        <small class="text-muted" style="font-size: 0.72rem;">Repairs certified</small>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 col-xl-2">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <small class="text-muted fw-bold">ACCESSIBILITY</small>
          <i class="bi bi-universal-access text-warning fs-5"></i>
        </div>
        <div class="fs-3 fw-bold text-warning-emphasis"><%= stats.accessibility %></div>
        <small class="text-muted" style="font-size: 0.72rem;">IR2 Barrier tickets</small>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 col-xl-2">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <small class="text-muted fw-bold">HIGH / URGENT</small>
          <i class="bi bi-exclamation-octagon text-danger fs-5"></i>
        </div>
        <div class="fs-3 fw-bold text-danger"><%= stats.urgentOrHigh %></div>
        <small class="text-muted" style="font-size: 0.72rem;">Active high priority</small>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <!-- Recent Campus Requests with Instant Dispatch (FN-5) -->
  <div class="col-xl-8">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
          <i class="bi bi-activity text-primary"></i>
          <span>Recent Campus Maintenance Submissions</span>
        </h5>
        <a href="/admin/requests" class="btn btn-outline-primary btn-sm fw-semibold">View All</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col" class="ps-3">Ticket</th>
                <th scope="col">Location &amp; Subject</th>
                <th scope="col">Status</th>
                <th scope="col">Assigned Tech</th>
                <th scope="col" class="text-end pe-3">Dispatch / Assign</th>
              </tr>
            </thead>
            <tbody>
              <% recentRequests.forEach(r => { %>
                <tr>
                  <td class="ps-3 fw-bold">
                    <a href="/requests/<%= r.id %>" class="text-decoration-none">
                      #<%= r.ticket_number %>
                    </a>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark text-truncate" style="max-width: 240px;"><%= r.title %></div>
                    <small class="text-muted"><%= r.building %> &bull; <%= r.room %></small>
                    <% if (r.is_private_area) { %>
                      <span class="badge bg-light text-secondary border ms-1" style="font-size: 0.65rem;">Private Area</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (r.status === 'Pending') { %>
                      <span class="badge badge-status-pending">Pending</span>
                    <% } else if (r.status === 'In Progress') { %>
                      <span class="badge badge-status-in-progress">In Progress</span>
                    <% } else if (r.status === 'Completed') { %>
                      <span class="badge badge-status-completed">Completed</span>
                    <% } else { %>
                      <span class="badge badge-status-cancelled">Cancelled</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (r.technician_name) { %>
                      <div class="small fw-semibold"><%= r.technician_name %></div>
                      <small class="text-primary font-monospace"><%= r.technician_staff_id %></small>
                    <% } else { %>
                      <span class="badge bg-danger-subtle text-danger">Unassigned</span>
                    <% } %>
                  </td>
                  <td class="text-end pe-3">
                    <form action="/admin/requests/<%= r.id %>/assign" method="POST" class="d-inline-flex gap-1 align-items-center">
                      <select name="technician_id" class="form-select form-select-sm" style="width: 140px;" required>
                        <option value="">Dispatch Tech...</option>
                        <% technicians.forEach(t => { %>
                          <option value="<%= t.id %>" <%= r.assigned_to === t.id ? 'selected' : '' %>>
                            <%= t.name.split(' ')[0] %> (<%= t.staff_id %>)
                          </option>
                        <% }) %>
                      </select>
                      <button type="submit" class="btn btn-sm btn-primary" title="Assign Technician">
                        <i class="bi bi-send-check"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Right: Breakdown Analytics -->
  <div class="col-xl-4">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3 border-bottom">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart text-primary me-2"></i>Requests by Category</h6>
      </div>
      <div class="card-body p-3">
        <% if (stats.byCategory && stats.byCategory.length > 0) { %>
          <% stats.byCategory.forEach(cat => { %>
            <div class="mb-3">
              <div class="d-flex justify-content-between small fw-semibold mb-1">
                <span><%= cat.category %></span>
                <span><%= cat.count %> tickets</span>
              </div>
              <div class="progress" style="height: 8px;">
                <div class="progress-bar <%= cat.category === 'Accessibility Barrier' ? 'bg-warning' : 'bg-primary' %>" 
                     role="progressbar" 
                     style="width: <%= Math.round((cat.count / stats.total) * 100) %>%;">
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- Active Technicians Roster -->
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-people text-primary me-2"></i>Physical Plant Staff</h6>
        <span class="badge bg-light text-dark border"><%= technicians.length %> active</span>
      </div>
      <div class="card-body p-3">
        <ul class="list-group list-group-flush">
          <% technicians.forEach(t => { %>
            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
              <div>
                <div class="fw-bold text-dark"><%= t.name %></div>
                <small class="text-muted"><%= t.specialization || 'Maintenance Technician' %></small>
              </div>
              <span class="badge bg-primary-subtle text-primary font-monospace"><%= t.staff_id %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
