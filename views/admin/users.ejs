<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">User Access Control &amp; Role Management</h1>
    <p class="text-muted small mb-0">Manage roles and permissions across students, faculty, and physical plant maintenance technicians.</p>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-people text-primary me-2"></i>Campus User Directory</h5>
    <span class="badge bg-light text-dark border"><%= users.length %> Registered Accounts</span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-4">User</th>
            <th scope="col">Institutional Email</th>
            <th scope="col">College / Department</th>
            <th scope="col">Staff / Student ID</th>
            <th scope="col">Current Role</th>
            <th scope="col">Submitted / Assigned</th>
            <th scope="col" class="text-end pe-4">Manage Access Role</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td class="ps-4">
                <div class="fw-bold text-dark"><%= u.name %></div>
                <% if (u.id === currentUser.id) { %>
                  <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.65rem;">You</span>
                <% } %>
              </td>
              <td class="text-muted small">
                <%= u.email %>
              </td>
              <td>
                <span class="small"><%= u.department || 'Campus Community' %></span>
              </td>
              <td>
                <% if (u.staff_id) { %>
                  <span class="font-monospace text-primary fw-semibold small"><%= u.staff_id %></span>
                <% } else { %>
                  <span class="text-muted small">&mdash;</span>
                <% } %>
              </td>
              <td>
                <% if (u.role === 'admin') { %>
                  <span class="badge bg-danger text-uppercase px-2 py-1">Administrator</span>
                <% } else if (u.role === 'staff') { %>
                  <span class="badge bg-primary text-uppercase px-2 py-1">Maintenance Staff</span>
                <% } else if (u.role === 'faculty') { %>
                  <span class="badge bg-info text-dark text-uppercase px-2 py-1">Faculty</span>
                <% } else { %>
                  <span class="badge bg-secondary text-uppercase px-2 py-1">Student</span>
                <% } %>
              </td>
              <td>
                <span class="badge bg-light text-dark border">
                  <%= u.request_count %> submitted
                </span>
                <% if (u.role === 'staff') { %>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">
                    <%= u.assigned_count %> assigned
                  </span>
                <% } %>
              </td>
              <td class="text-end pe-4">
                <% if (u.id !== currentUser.id) { %>
                  <form action="/admin/users/<%= u.id %>/role" method="POST" class="d-inline-flex gap-1 justify-content-end align-items-center">
                    <select name="role" class="form-select form-select-sm" style="width: 140px;">
                      <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>Student</option>
                      <option value="faculty" <%= u.role === 'faculty' ? 'selected' : '' %>>Faculty</option>
                      <option value="staff" <%= u.role === 'staff' ? 'selected' : '' %>>Maintenance Staff</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Administrator</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Update Role">
                      <i class="bi bi-check2"></i>
                    </button>
                  </form>
                <% } else { %>
                  <span class="badge bg-light text-muted border">Current User</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
