<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Welcome, <%= user.name %>!</h1>
    <p class="text-muted mb-0">Track and report physical facility repairs across CSPC campus buildings.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/requests/new" class="btn btn-warning text-dark fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-2">
      <i class="bi bi-plus-circle-fill fs-5"></i>
      <span>Submit New Request</span>
    </a>
  </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-card-icon bg-primary bg-opacity-10 text-primary">
          <i class="bi bi-ticket-detailed fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold lh-1"><%= stats.total %></div>
          <small class="text-muted fw-semibold">Total Requests</small>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-card-icon bg-warning bg-opacity-10 text-warning">
          <i class="bi bi-hourglass-split fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold lh-1"><%= stats.pending %></div>
          <small class="text-muted fw-semibold">Pending Review</small>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-card-icon bg-info bg-opacity-10 text-info">
          <i class="bi bi-gear-wide-connected fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold lh-1"><%= stats.inProgress %></div>
          <small class="text-muted fw-semibold">In Progress</small>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="card shadow-sm border-0 h-100 card-hover">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-card-icon bg-success bg-opacity-10 text-success">
          <i class="bi bi-check2-circle fs-4"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold lh-1"><%= stats.completed %></div>
          <small class="text-muted fw-semibold">Resolved</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Main Content Row -->
<div class="card shadow-sm border-0 mb-4">
  <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
      <i class="bi bi-clock-history text-primary"></i>
      <span>Recent Submitted Requests</span>
    </h5>
    <a href="/requests" class="btn btn-outline-primary btn-sm fw-semibold">
      View All My Tickets (<%= stats.total %>)
    </a>
  </div>
  <div class="card-body p-0">
    <% if (recentRequests && recentRequests.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="ps-4">Ticket</th>
              <th scope="col">Subject &amp; Location</th>
              <th scope="col">Category</th>
              <th scope="col">Priority</th>
              <th scope="col">Status</th>
              <th scope="col">Submitted</th>
              <th scope="col" class="text-end pe-4">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% recentRequests.forEach(reqItem => { %>
              <tr>
                <td class="ps-4 fw-semibold text-primary">
                  <a href="/requests/<%= reqItem.id %>" class="text-decoration-none">
                    #<%= reqItem.ticket_number %>
                  </a>
                </td>
                <td>
                  <div class="fw-semibold text-dark"><%= reqItem.title %></div>
                  <small class="text-muted">
                    <i class="bi bi-geo-alt me-1"></i><%= reqItem.building %>, <%= reqItem.room %>
                  </small>
                  <% if (reqItem.is_private_area) { %>
                    <span class="badge bg-light text-secondary border ms-1" title="Private Area (IR3 Protected)">
                      <i class="bi bi-lock-fill me-1"></i>Private Area
                    </span>
                  <% } %>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <%= reqItem.category %>
                  </span>
                </td>
                <td>
                  <% if (reqItem.priority === 'Urgent') { %>
                    <span class="badge badge-priority-urgent">Urgent</span>
                  <% } else if (reqItem.priority === 'High') { %>
                    <span class="badge badge-priority-high">High</span>
                  <% } else if (reqItem.priority === 'Normal') { %>
                    <span class="badge badge-priority-normal">Normal</span>
                  <% } else { %>
                    <span class="badge badge-priority-low">Low</span>
                  <% } %>
                </td>
                <td>
                  <% if (reqItem.status === 'Pending') { %>
                    <span class="badge badge-status-pending"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                  <% } else if (reqItem.status === 'In Progress') { %>
                    <span class="badge badge-status-in-progress"><i class="bi bi-wrench me-1"></i>In Progress</span>
                  <% } else if (reqItem.status === 'Completed') { %>
                    <span class="badge badge-status-completed"><i class="bi bi-check-circle me-1"></i>Completed</span>
                  <% } else { %>
                    <span class="badge badge-status-cancelled">Cancelled</span>
                  <% } %>
                </td>
                <td class="text-muted small">
                  <%= new Date(reqItem.created_at).toLocaleDateString() %>
                  <div class="text-secondary" style="font-size: 0.75rem;"><%= new Date(reqItem.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></div>
                </td>
                <td class="text-end pe-4">
                  <a href="/requests/<%= reqItem.id %>" class="btn btn-sm btn-outline-secondary">
                    View <i class="bi bi-chevron-right ms-1"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <div class="display-6 text-muted mb-3"><i class="bi bi-inbox"></i></div>
        <h5 class="fw-bold">No Maintenance Requests Submitted Yet</h5>
        <p class="text-muted small mb-4">Notice an issue in a classroom, laboratory, restroom, or campus pathway? Submit a ticket now!</p>
        <a href="/requests/new" class="btn btn-primary px-4 fw-semibold">
          <i class="bi bi-plus-lg me-1"></i> Submit First Request
        </a>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
