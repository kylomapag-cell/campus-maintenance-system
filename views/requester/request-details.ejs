<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <h1 class="h3 fw-bold mb-0">Ticket #<%= request.ticket_number %></h1>
      <% if (request.status === 'Pending') { %>
        <span class="badge badge-status-pending px-3 py-1"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
      <% } else if (request.status === 'In Progress') { %>
        <span class="badge badge-status-in-progress px-3 py-1"><i class="bi bi-wrench me-1"></i>In Progress</span>
      <% } else if (request.status === 'Completed') { %>
        <span class="badge badge-status-completed px-3 py-1"><i class="bi bi-check-circle me-1"></i>Completed</span>
      <% } else { %>
        <span class="badge badge-status-cancelled px-3 py-1">Cancelled</span>
      <% } %>

      <% if (request.priority === 'Urgent') { %>
        <span class="badge badge-priority-urgent px-2 py-1">Urgent Priority</span>
      <% } else if (request.priority === 'High') { %>
        <span class="badge badge-priority-high px-2 py-1">High Priority</span>
      <% } %>
    </div>
    <p class="text-muted small mb-0">Logged on <%= new Date(request.created_at).toLocaleString() %></p>
  </div>

  <div class="d-flex gap-2">
    <% if (currentUser.role === 'admin') { %>
      <a href="/admin/requests" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> All Tickets
      </a>
    <% } else if (currentUser.role === 'staff') { %>
      <a href="/staff/dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Technician Dashboard
      </a>
    <% } else { %>
      <a href="/requests" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> My Requests
      </a>
    <% } %>
  </div>
</div>

<div class="row g-4">
  <!-- Left Column: Details, Photos, Safety Badge -->
  <div class="col-lg-8">

    <!-- Inclusive Requirement IR3: Private Area Safety & Verification Notice -->
    <% if (request.is_private_area) { %>
      <div class="card safety-badge-card shadow-sm mb-4">
        <div class="card-body p-4">
          <div class="d-flex align-items-start gap-3">
            <div class="p-3 bg-success bg-opacity-10 text-success rounded-circle flex-shrink-0">
              <i class="bi bi-shield-lock-fill fs-2"></i>
            </div>
            <div class="flex-grow-1">
              <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-success-emphasis mb-1">
                  <i class="bi bi-shield-check me-1"></i> Occupant Safety &amp; Room Entry Protocol (IR3)
                </h5>
                <span class="badge bg-success text-white">Private Area Verified</span>
              </div>
              <p class="small text-muted mb-3">
                This maintenance request is located in a private area (such as a comfort room or isolated faculty office). For occupant privacy and security, only authorized personnel with verified credentials may enter.
              </p>

              <% if (request.technician_name) { %>
                <div class="p-3 bg-white rounded-3 border d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                  <div>
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Assigned CSPC Technician</small>
                    <div class="fw-bold fs-5 text-dark"><%= request.technician_name %></div>
                    <div class="small text-muted"><%= request.technician_specialization || 'Physical Plant Staff' %></div>
                  </div>
                  <div class="text-sm-end">
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Official Staff Badge ID</small>
                    <div class="fw-bold font-monospace fs-5 text-primary">
                      <i class="bi bi-person-badge me-1"></i><%= request.technician_staff_id || 'CSPC-VERIFIED' %>
                    </div>
                  </div>
                </div>
              <% } else { %>
                <div class="alert alert-warning mb-0 small">
                  <i class="bi bi-hourglass-split me-1"></i> A technician has not yet been dispatched to this private area. Once assigned by Physical Plant, their official CSPC ID and verification badge will appear here.
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Ticket Main Overview Card -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body p-4">
        <h4 class="fw-bold text-dark mb-3"><%= request.title %></h4>

        <div class="row g-3 mb-4 p-3 bg-light rounded-3">
          <div class="col-sm-6 col-md-3">
            <small class="text-muted d-block fw-semibold">Campus Building</small>
            <div class="fw-bold text-dark"><i class="bi bi-building me-1 text-primary"></i><%= request.building %></div>
          </div>
          <div class="col-sm-6 col-md-3">
            <small class="text-muted d-block fw-semibold">Floor &amp; Room</small>
            <div class="fw-bold text-dark"><i class="bi bi-geo-alt me-1 text-primary"></i><%= request.floor %>, <%= request.room %></div>
          </div>
          <div class="col-sm-6 col-md-3">
            <small class="text-muted d-block fw-semibold">Category</small>
            <div>
              <span class="badge bg-white text-dark border"><%= request.category %></span>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <small class="text-muted d-block fw-semibold">Priority</small>
            <div class="fw-bold">
              <% if (request.priority === 'Urgent') { %>
                <span class="text-danger"><i class="bi bi-exclamation-octagon me-1"></i>Urgent</span>
              <% } else if (request.priority === 'High') { %>
                <span class="text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>High</span>
              <% } else { %>
                <span class="text-secondary"><i class="bi bi-check me-1"></i><%= request.priority %></span>
              <% } %>
            </div>
          </div>
        </div>

        <h6 class="fw-bold text-secondary text-uppercase mb-2" style="font-size: 0.75rem;">Problem Description</h6>
        <div class="p-3 border rounded bg-white text-dark mb-4" style="line-height: 1.6;">
          <%= request.description %>
        </div>

        <!-- Attached Photo -->
        <% if (request.photo_url) { %>
          <div class="mb-4">
            <h6 class="fw-bold text-secondary text-uppercase mb-2" style="font-size: 0.75rem;">
              <i class="bi bi-image me-1"></i> Attached Evidence Photo
            </h6>
            <div class="position-relative d-inline-block">
              <a href="<%= request.photo_url %>" target="_blank" title="Click to view full photo">
                <img src="<%= request.photo_url %>" alt="Issue photo" class="ticket-photo-preview img-fluid shadow-sm">
              </a>
              <div class="small text-muted mt-1"><i class="bi bi-zoom-in me-1"></i>Click photo to open in new tab</div>
            </div>
          </div>
        <% } %>

        <!-- Resolution Notes Section if present -->
        <% if (request.resolution_notes) { %>
          <div class="p-3 bg-success bg-opacity-10 border border-success-subtle rounded-3">
            <h6 class="fw-bold text-success d-flex align-items-center gap-1 mb-2">
              <i class="bi bi-check2-circle fs-5"></i> Resolution &amp; Repair Notes
            </h6>
            <p class="mb-1 text-dark"><%= request.resolution_notes %></p>
            <% if (request.completed_at) { %>
              <small class="text-muted">Completed on <%= new Date(request.completed_at).toLocaleString() %></small>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Audit History / Status Timeline -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
          <i class="bi bi-clock-history text-primary"></i>
          <span>Status History &amp; Audit Trail</span>
        </h5>
      </div>
      <div class="card-body p-4">
        <% if (request.logs && request.logs.length > 0) { %>
          <div class="timeline">
            <% request.logs.forEach(log => { %>
              <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <strong class="text-dark"><%= log.action %></strong>
                    <% if (log.user_name) { %>
                      <span class="text-muted small">&bull; by <%= log.user_name %> (<%= log.user_role %>)</span>
                    <% } %>
                    <% if (log.details) { %>
                      <div class="text-muted small mt-1"><%= log.details %></div>
                    <% } %>
                  </div>
                  <small class="text-secondary ps-3 text-nowrap"><%= new Date(log.created_at).toLocaleString() %></small>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-0">No history logged yet.</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Right Column: Status Actions, Requester info, Technician info -->
  <div class="col-lg-4">

    <!-- Staff / Admin Action Card: Status Update (FN-7, FN-9) -->
    <% if (currentUser.role === 'staff' || currentUser.role === 'admin') { %>
      <div class="card shadow-sm border-0 mb-4 border-start border-primary border-4">
        <div class="card-header bg-white py-3">
          <h5 class="fw-bold mb-0 text-primary">
            <i class="bi bi-tools me-1"></i> Technician Work Action
          </h5>
        </div>
        <div class="card-body p-3">
          <!-- Unassigned ticket claim action -->
          <% if (!request.assigned_to && currentUser.role === 'staff') { %>
            <form action="/staff/requests/<%= request.id %>/claim" method="POST" class="mb-3">
              <button type="submit" class="btn btn-warning w-100 fw-bold py-2 shadow-sm">
                <i class="bi bi-hand-index-thumb me-1"></i> Claim Ticket Work Order
              </button>
            </form>
          <% } %>

          <form action="/staff/requests/<%= request.id %>/status" method="POST">
            <div class="mb-3">
              <label for="status" class="form-label fw-semibold">Update Ticket Status</label>
              <select class="form-select" id="status" name="status" required>
                <option value="Pending" <%= request.status === 'Pending' ? 'selected' : '' %>>Pending Review</option>
                <option value="In Progress" <%= request.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                <option value="Completed" <%= request.status === 'Completed' ? 'selected' : '' %>>Mark as Completed</option>
                <option value="Cancelled" <%= request.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="resolution_notes" class="form-label fw-semibold">Resolution Remarks / Notes</label>
              <textarea 
                class="form-control" 
                id="resolution_notes" 
                name="resolution_notes" 
                rows="3" 
                placeholder="Explain what repairs were conducted, parts replaced, or ongoing inspection details..."
              ><%= request.resolution_notes || '' %></textarea>
              <div class="form-text">Required when marking ticket as Completed.</div>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-semibold">
              <i class="bi bi-check2-circle me-1"></i> Save Status Update
            </button>
          </form>
        </div>
      </div>
    <% } %>

    <!-- Requester Information Card -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3 border-bottom">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-person me-2 text-primary"></i>Requester Information</h6>
      </div>
      <div class="card-body p-3">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="p-2 bg-light rounded-circle text-primary">
            <i class="bi bi-person-circle fs-3"></i>
          </div>
          <div>
            <div class="fw-bold text-dark"><%= request.requester_name %></div>
            <span class="badge bg-secondary-subtle text-secondary text-uppercase" style="font-size: 0.68rem;"><%= request.requester_role %></span>
          </div>
        </div>
        <ul class="list-group list-group-flush small">
          <li class="list-group-item px-0 d-flex justify-content-between">
            <span class="text-muted">CSPC Email:</span>
            <span class="fw-semibold text-truncate" style="max-width: 170px;"><%= request.requester_email %></span>
          </li>
          <li class="list-group-item px-0 d-flex justify-content-between">
            <span class="text-muted">Department:</span>
            <span class="fw-semibold"><%= request.requester_dept || 'Student / Campus' %></span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Assigned Maintenance Staff Card -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-wrench me-2 text-primary"></i>Assigned Technician</h6>
        <% if (currentUser.role === 'admin') { %>
          <span class="badge bg-light text-primary border">Admin Control</span>
        <% } %>
      </div>
      <div class="card-body p-3">
        <% if (request.technician_name) { %>
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="p-2 bg-primary bg-opacity-10 rounded-circle text-primary">
              <i class="bi bi-person-badge fs-3"></i>
            </div>
            <div>
              <div class="fw-bold text-dark"><%= request.technician_name %></div>
              <small class="text-primary font-monospace fw-bold"><%= request.technician_staff_id %></small>
            </div>
          </div>
          <ul class="list-group list-group-flush small">
            <li class="list-group-item px-0 d-flex justify-content-between">
              <span class="text-muted">Specialty:</span>
              <span class="fw-semibold"><%= request.technician_specialization || 'Physical Plant Staff' %></span>
            </li>
            <li class="list-group-item px-0 d-flex justify-content-between">
              <span class="text-muted">Assigned Date:</span>
              <span><%= request.assigned_at ? new Date(request.assigned_at).toLocaleDateString() : 'Pending' %></span>
            </li>
          </ul>
        <% } else { %>
          <div class="text-center py-3 text-muted">
            <i class="bi bi-clock fs-3 d-block mb-1"></i>
            <small class="d-block mb-2">No technician assigned yet.</small>
          </div>
        <% } %>

        <!-- Admin Dispatch Action -->
        <% if (currentUser.role === 'admin') { %>
          <hr>
          <form action="/admin/requests/<%= request.id %>/assign" method="POST">
            <label for="technician_id" class="form-label small fw-semibold text-secondary">
              <%= request.assigned_to ? 'Reassign Technician' : 'Dispatch Technician' %>
            </label>
            <div class="input-group">
              <select class="form-select form-select-sm" name="technician_id" required>
                <option value="">-- Choose Staff --</option>
                <option value="2" <%= request.assigned_to === 2 ? 'selected' : '' %>>Juan Dela Cruz (Electrical &amp; AV)</option>
                <option value="3" <%= request.assigned_to === 3 ? 'selected' : '' %>>Ricardo Santos (Plumbing &amp; Civil)</option>
              </select>
              <button class="btn btn-primary btn-sm" type="submit">Assign</button>
            </div>
          </form>
        <% } %>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
